{
  "name": "backend-mysql",
  "version": "1.0.0",
  "description": "Backend del Sistema de Gestión de Empleados y Horarios con MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
