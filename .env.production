# Variables de entorno para Railway
NODE_ENV=production
PORT=$PORT

# Base de datos (Railway proporcionará estas variables)
DB_HOST=$RAILWAY_PRIVATE_MYSQL_HOST
DB_PORT=$RAILWAY_PRIVATE_MYSQL_PORT
DB_NAME=$RAILWAY_PRIVATE_MYSQL_DATABASE
DB_USER=$RAILWAY_PRIVATE_MYSQL_USER
DB_PASSWORD=$RAILWAY_PRIVATE_MYSQL_PASSWORD

# JWT (Configurar en Railway Dashboard)
JWT_SECRET=$JWT_SECRET
JWT_EXPIRES_IN=24h

# SendGrid (Configurar en Railway Dashboard - opcional)
SENDGRID_API_KEY=$SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=$SENDGRID_FROM_EMAIL

# Seguridad
BCRYPT_ROUNDS=10
